# Citation metadata for the RoSE toolkit.
# GitHub renders this as the "Cite this repository" button in the sidebar.
# On each tagged release, bump `version`, `date-released`, and `doi`
# (and `identifiers[].value`) to the new release's values.
cff-version: 1.2.0
message: "If you use this software, please cite it as below."
type: software
title: "RoSE — Romanian SEismic Dataset (toolkit)"
abstract: >
  Python toolkit, three published deep-learning phase pickers
  (EQT-RoSE, PhaseNet-RoSE, RED-PAN-60s), and the benchmark pipeline
  that scores them on the RoSE Romanian seismic dataset.
authors:
  - family-names: "Liao"
    given-names: "Wu-Yu"
    orcid: "https://orcid.org/0000-0003-2353-7006"
    affiliation: "Department of Earth Sciences, National Cheng Kung University, Tainan, Taiwan"
  - family-names: "Manea"
    given-names: "Elena-Florinela"
    affiliation: "National Institute for Earth Physics, Măgurele, Romania"
  - family-names: "Mărmureanu"
    given-names: "Alexandru"
    affiliation: "National Institute for Earth Physics, Măgurele, Romania"
  - family-names: "Lee"
    given-names: "En-Jui"
    affiliation: "Department of Earth Sciences, National Cheng Kung University, Tainan, Taiwan"
repository-code: "https://github.com/tso1257771/RoSE"
url: "https://github.com/tso1257771/RoSE"
license: MIT
version: v0.3.0
date-released: 2026-10-05
# Concept DOI: always resolves to the newest version. Prefer it in prose.
doi: "10.5281/zenodo.20250669"
identifiers:
  - type: doi
    value: "10.5281/zenodo.20250669"
    description: "Concept DOI (all versions)"
  - type: doi
    value: "10.5281/zenodo.20250670"
    description: "Version DOI for v0.1.0"
  # After publishing the v0.3.0 Zenodo record, add its version DOI here.
keywords:
  - seismology
  - phase picking
  - earthquake detection
  - machine learning
  - SeisBench
  - EQTransformer
  - PhaseNet
  - RED-PAN
  - Romania
  - Vrancea
