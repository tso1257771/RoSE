    affiliation: "Institute of Earth Sciences, Academia Sinica, Taipei, Taiwan"
  - family-names: "Manea"
    given-names: "Elena-Florinela"
    orcid: "https://orcid.org/0000-0002-0938-8617"
    affiliation: "National Institute for Earth Physics, Măgurele, Romania"
  - family-names: "Mărmureanu"
    given-names: "Alexandru"
    orcid: "https://orcid.org/0000-0002-2181-4471"
    affiliation: "National Institute for Earth Physics, Măgurele, Romania"
  - family-names: "Lee"
    given-names: "En-Jui"
    orcid: "https://orcid.org/0000-0003-1545-1640"
    affiliation: "Department of Earth Sciences, National Cheng Kung University, Tainan, Taiwan"
